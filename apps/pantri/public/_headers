# Vite content-hashes everything under /assets/*, so these can be cached forever.
# Cloudflare Static Assets default is max-age=0, must-revalidate without this file.
# https://developers.cloudflare.com/workers/static-assets/headers/
# https://github.com/cloudflare/workers-sdk/issues/8997
/assets/*
  Cache-Control: public, max-age=31536000, immutable
