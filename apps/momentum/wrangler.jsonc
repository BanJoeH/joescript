{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "momentum-dev",
  "compatibility_date": "2026-06-30",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "momentum-dev.joescript.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://momentum-dev.joescript.io"
  },
  "env": {
    "production": {
      "name": "momentum-prod",
      "routes": [
        {
          "pattern": "momentum.joescript.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://momentum.joescript.io"
      }
    }
  }
}
