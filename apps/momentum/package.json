{
  "name": "@joescript/momentum",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "codegen": "wrangler types && react-router typegen",
    "typecheck": "pnpm run codegen && tsc -b",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "MOMENTUM_MIGRATE_ENV=dev drizzle-kit migrate",
    "db:migrate:prod": "MOMENTUM_MIGRATE_ENV=prod drizzle-kit migrate",
    "db:migrate:local": "MOMENTUM_MIGRATE_ENV=local drizzle-kit migrate",
    "db:studio": "MOMENTUM_MIGRATE_ENV=dev drizzle-kit studio",
    "db:studio:prod": "MOMENTUM_MIGRATE_ENV=prod drizzle-kit studio",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@radix-ui/react-slot": "^1.2.4",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "isbot": "^5.1.36",
    "lucide-react": "^0.577.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.105.0"
  }
}
