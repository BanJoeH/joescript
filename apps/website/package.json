{
  "name": "@joescript/website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "codegen": "wrangler types && react-router typegen",
    "typecheck": "pnpm run codegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.105.0"
  }
