{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-dev",
  "compatibility_date": "2026-06-30",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "website-dev.joescript.io",
      "custom_domain": true
    }
  ],
  "env": {
    "production": {
      "name": "website-prod",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "joescript.io",
          "custom_domain": true
        },
        {
          "pattern": "www.joescript.io",
          "custom_domain": true
        }
      ]
    }
  }
}
