{
  "name": "joescript",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev:garden": "pnpm --filter @joescript/garden dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "pnpm -r typecheck",
    "dev:momentum": "pnpm --filter @joescript/momentum dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  }
}
